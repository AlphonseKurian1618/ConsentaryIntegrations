    "chatgpt": {
      "displayName": "ChatGPT",
      "identityAssurance": "known_provider",
      "connectionMethod": "consentary_plugin_oauth"
    },
    "claude": {
      "displayName": "Claude",
      "identityAssurance": "known_provider",
      "connectionMethod": "consentary_plugin_oauth"
    },
    "vscode": {
      "displayName": "Visual Studio Code",
      "identityAssurance": "known_provider",
      "connectionMethod": "remote_mcp_oauth"
    }
  },
  "genericClient": {
    "provider": "generic_mcp",
